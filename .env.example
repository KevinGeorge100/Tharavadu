# =============================================================================
# Tharavadu — Environment Configuration Template
# Copy this file to .env before starting the backend service.
# DO NOT COMMIT REAL SECRETS OR .env TO VERSION CONTROL.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Relational Metadata & Snapshots)
# -----------------------------------------------------------------------------
# Default Local Mode: SQLite file in the working directory
DATABASE_URL=sqlite:///./tharavadu.db

# Optional Production-Like Mode: PostgreSQL (requires psycopg driver)
# DATABASE_URL=postgresql+psycopg://tharavadu_user:tharavadu_password@localhost:5432/tharavadu

# -----------------------------------------------------------------------------
# 2. GRAPH REPOSITORY BACKEND
# -----------------------------------------------------------------------------
# Supported values: "local" (default) or "neo4j"
# - local: JSON graph snapshots stored in the relational database (local_graphs table)
# - neo4j: Graph nodes and edges persisted in Neo4j with Cypher transactions
GRAPH_BACKEND=local

# Neo4j Settings (active only when GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace_when_using_neo4j

# -----------------------------------------------------------------------------
# 3. AI / NLP EXTRACTION PROVIDER
# -----------------------------------------------------------------------------
# Supported values: "offline" (default) or "openai"
# - offline: Deterministic regex English grammar parser (zero cloud dependencies)
# - openai:  OpenAI Structured Outputs (gpt-4.1-mini) via client.responses.parse
AI_PROVIDER=offline

# OpenAI Settings (active only when AI_PROVIDER=openai)
# OPENAI_API_KEY=replace_when_using_openai
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# 4. SECURITY & SESSION MANAGEMENT
# -----------------------------------------------------------------------------
# Expected browser Origin for state-changing API requests; Next.js proxies /api
# from this same origin. This is a CSRF safeguard, not a CORS allowlist.
APP_ORIGIN=http://localhost:3000

# Set COOKIE_SECURE=True in production over HTTPS (sends cookies only over HTTPS)
COOKIE_SECURE=False

# Session cookie lifetime in days
SESSION_DAYS=7

# -----------------------------------------------------------------------------
# 5. FRONTEND REVERSE PROXY (Next.js)
# -----------------------------------------------------------------------------
# Backend API address used by frontend/next.config.ts rewrites.
# Set this in the frontend process environment or frontend/.env.local when
# overriding the default; the repository-root .env is read by Python only.
# API_URL=http://127.0.0.1:8000
